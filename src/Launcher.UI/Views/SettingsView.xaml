<UserControl x:Class="Launcher.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Launcher.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,8,40,28" MaxWidth="1400">
            <TextBlock Text="Настройки" Style="{StaticResource Heading}" Margin="0,0,0,18" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <TextBlock Text="Внешний вид" Style="{StaticResource SubHeading}" />
                    <Grid Margin="0,12,0,0">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Экономный режим" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5"
                                       Text="Отключает анимации и дым на фоне. Полезно на слабых компьютерах и от ноутбучного аккумулятора. Фон также замирает сам, пока игра запущена или окно свёрнуто." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding EcoMode, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Экономия при бездействии" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Если в окне лаунчера 10 секунд ничего не нажимали и не двигали мышью, он сам переходит в экономный режим: анимации и вращение модели замирают. Любое движение мыши возвращает всё обратно." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding IdleEco, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Свечение на фоне" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Мягкий движущийся «дым» позади окна. Если выключить, фон станет ровным и перестанет тратить ресурсы." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding BackgroundGlow, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Тема и цвета" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Content="Сбросить цвета" HorizontalAlignment="Right"
                                Padding="14,7" FontSize="12" c:Ui.CornerRadius="11" Command="{Binding ResetColorsCommand}" />
                    </Grid>

                    <TextBlock Text="Тема" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding ThemeChoices}"
                             SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Жидкое стекло" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Панели и окна получают переливающийся блик и светлую кромку, как стекло. Меняется только оформление: нагрузка на компьютер не растёт. Включается и выключается сразу." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding LiquidGlass, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="Основной цвет" FontWeight="SemiBold" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding AccentSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="30" Height="30" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding Hex}"
                                        Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Hex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Ellipse Fill="{Binding Brush}" Stroke="{DynamicResource PanelBorderBrush}" StrokeThickness="1.5" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:ColorWheel Width="220" HorizontalAlignment="Left" Margin="0,4,0,12"
                                  Hex="{Binding AccentText, Delay=80}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   FontSize="12" Text="Выберите цвет на круге или впишите код #RRGGBB, например #FF8FB1." />
                    </Grid>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,-4,0,8"
                               Text="Некорректная запись цвета: нужно #RRGGBB."
                               Visibility="{Binding AccentTextInvalid, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="Фон" FontWeight="SemiBold" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding BackgroundSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="30" Height="30" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding Hex}"
                                        Command="{Binding DataContext.SetBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Hex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Ellipse Fill="{Binding Brush}" Stroke="{DynamicResource PanelBorderBrush}" StrokeThickness="1.5" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:ColorWheel Width="220" HorizontalAlignment="Left" Margin="0,4,0,12"
                                  Hex="{Binding BackgroundText, Delay=80}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BackgroundText, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Text="Цвет текста подстраивается под яркость фона. Смена темы возвращает фон к стандартному." />
                    </Grid>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,6,0,0"
                               Text="Некорректная запись цвета: нужно #RRGGBB."
                               Visibility="{Binding BackgroundTextInvalid, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <TextBlock Text="Папки" Style="{StaticResource SubHeading}" />
                    <TextBlock Text="{Binding RootPath}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Content="Папка лаунчера" Margin="0,0,8,8"
                                Command="{Binding OpenLauncherFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Файлы игры" Margin="0,0,8,8"
                                Command="{Binding OpenGameFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Журналы" Margin="0,0,8,8"
                                Command="{Binding OpenLogsFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                        <StackPanel>
                            <TextBlock Text="Обновления" Style="{StaticResource SubHeading}" />
                            <Grid Margin="0,12,0,0">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="Проверять обновления" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                               Text="При запуске и раз в несколько часов лаунчер смотрит, не вышла ли новая версия. Если вышла, появится окно и вкладка «Обновление»." />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{Binding Updates.LastCheckText}" Style="{StaticResource Muted}" FontSize="12.5"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,200,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Проверить обновления" HorizontalAlignment="Right"
                                        Padding="14,7" FontSize="12" c:Ui.CornerRadius="11" Command="{Binding Updates.CheckNowCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,16" Padding="22,16" MouseLeftButtonUp="OnVersionClick">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Лаунчер Minecraft" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="20" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Java" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Content="Найти заново" HorizontalAlignment="Right"
                                Padding="14,7" FontSize="12" c:Ui.CornerRadius="11" Command="{Binding ScanCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,10"
                               Text="Обычно выбирать ничего не нужно: лаунчер сам подбирает подходящую Java под версию игры. Выберите вариант вручную, только если нужна конкретная." />
                    <TextBlock Text="Ищу установленные Java…" Style="{StaticResource Muted}"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    <ListBox Style="{StaticResource ChipListBox}" MaxHeight="220" ItemsSource="{Binding JavaChoices}"
                             SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <TextBlock Text="Модель персонажа на главной" Style="{StaticResource SubHeading}" />
                    <Grid Margin="0,10,0,4">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Показывать 3D-персонажа" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Если выключить, модель пропадёт, нагрузка на компьютер упадёт, а панель запуска на главной встанет по центру." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding Account.ShowModel3D, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,10,0,4">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Вращать персонажа" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Если выключить, модель стоит неподвижно (её по-прежнему можно повернуть мышью)." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding Account.ModelSpin, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,10"
                               Text="По умолчанию справа на главной показывается стандартная модель игрока с вашим скином. Можно подключить свою модель из Blockbench (файл .bbmodel): поддерживаются кубики с текстурой и повороты групп; анимации и меши не учитываются." />
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Выбрать модель Blockbench…" Margin="0,0,10,8"
                                Command="{Binding Account.ChooseModelCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Стандартная модель" Margin="0,0,10,8"
                                Command="{Binding Account.ResetModelCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Сохранить шаблон для Blockbench…" Margin="0,0,0,8"
                                Command="{Binding Account.ExportTemplateCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Account.ModelNote}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <Grid Margin="0,14,0,0">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Свой скин на своей модели" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Накладывать выбранный скин на модель из Blockbench вместо текстуры из файла. Для шаблона лаунчера это включено всегда." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding Account.ModelUseSkin, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="Стандартная модель: настройка" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding Account.PoseChoices}"
                             SelectedItem="{Binding Account.SelectedPose, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,12,0,0">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Второй слой скина" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="Шапка, куртка, рукава и штаны поверх основной модели." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding Account.ModelOverlay, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <TextBlock Text="Значки профилей" Style="{StaticResource SubHeading}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,10" TextWrapping="Wrap"
                               Text="В папке значков лежат картинки (.png, .jpg), которые подхватываются автоматически. Новому профилю достаётся случайная; поменять её можно в настройках профиля (кнопка с шестерёнкой на карточке)." />
                    <Button Style="{StaticResource GhostButton}" Content="Открыть папку значков" HorizontalAlignment="Left"
                            Command="{Binding OpenIconsFolderCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <TextBlock Text="CurseForge" Style="{StaticResource SubHeading}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,10" TextWrapping="Wrap"
                               Text="Нужен для импорта сборок CurseForge (zip с manifest.json). В лаунчер уже встроен ключ, поэтому ничего вводить не нужно. Если хотите использовать свой (console.curseforge.com), впишите его сюда: он главнее встроенного и хранится в файле настроек открытым текстом." />
                    <TextBox Text="{Binding CurseForgeKey, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
