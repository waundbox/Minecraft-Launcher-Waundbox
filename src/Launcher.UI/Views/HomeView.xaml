<UserControl x:Class="Launcher.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Launcher.UI.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" MinWidth="380" />
            <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <c:EditorGrid Grid.ColumnSpan="2" />

        <!-- Справа: 3D-модель игрока со скином (перетаскивайте мышью, чтобы повернуть) -->
        <c:EditableElement Id="model" Grid.Column="1" Margin="0,16,16,16" MaxWidth="640">
            <c:SkinViewer Visibility="{Binding Account.ShowModel3D, Converter={StaticResource BoolToVis}}"
                          SkinPng="{Binding Account.ModelSkinPng}" Slim="{Binding Account.ModelSlim}" Model="{Binding Account.CustomModel}"
                          PoseId="{Binding Account.ModelPoseId}" ShowOverlay="{Binding Account.ModelOverlay}" AutoSpin="{Binding Account.ModelSpin}"
                          c:Motion.Appear="True" />
        </c:EditableElement>

        <!-- Панель запуска: при выключенной 3D-модели занимает обе колонки и стоит по центру -->
        <StackPanel VerticalAlignment="Center" MaxWidth="720" Margin="24,0,24,24">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="PanelScale" />
            </StackPanel.LayoutTransform>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Account.ShowModel3D}" Value="False">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Название лаунчера с «бликом» -->
            <c:EditableElement Id="wordmark">
            <TextBlock x:Name="Wordmark" HorizontalAlignment="Center" FontSize="72" FontWeight="Light"
                       Text="W&#x2009;A&#x2009;U&#x2009;N&#x2009;D&#x2009;B&#x2009;O&#x2009;X"
                       c:Motion.Appear="True">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="ShimmerShift" X="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="{DynamicResource WordmarkDimColor}" Offset="0.35" />
                        <GradientStop Color="{DynamicResource WordmarkBrightColor}" Offset="0.5" />
                        <GradientStop Color="{DynamicResource WordmarkDimColor}" Offset="0.65" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            </c:EditableElement>
            <c:EditableElement Id="tagline">
                <TextBlock Text="Лаунчер Minecraft" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                           Margin="0,2,0,26" FontSize="14" c:Motion.Appear="True" />
            </c:EditableElement>

            <c:EditableElement Id="panel">
            <Border Style="{StaticResource Glass}" Padding="30" c:Motion.Appear="True">
                <StackPanel>

                    <!-- Есть профили -->
                    <StackPanel Visibility="{Binding Catalog.HasItems, Converter={StaticResource BoolToVis}}">
                        <c:EditableElement Id="profiles">
                        <StackPanel>
                        <TextBlock Text="Профиль" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <ListBox x:Name="ProfileList" Style="{StaticResource ChipListBox}" MaxHeight="124"
                                 ItemsSource="{Binding Catalog.Items}"
                                 SelectedItem="{Binding Catalog.Selected, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>
                        </c:EditableElement>

                        <c:EditableElement Id="play">
                        <Grid Margin="0,18,0,0" MinHeight="74">
                            <Border x:Name="Glow" Margin="-6" CornerRadius="26" CacheMode="BitmapCache" Background="{DynamicResource AccentBrush}"
                                    Opacity="0.15" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                    Visibility="{Binding Catalog.Selected.IsIdle, Converter={StaticResource BoolToVis}}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="GlowScale" />
                                </Border.RenderTransform>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}" FontSize="22" c:Ui.CornerRadius="20"
                                    Command="{Binding Launcher.PlayCommand}" CommandParameter="{Binding Catalog.Selected}"
                                    Visibility="{Binding Catalog.Selected.IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,10,0" />
                                    <TextBlock Text="Играть" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" FontSize="20" c:Ui.CornerRadius="20"
                                    Command="{Binding Launcher.StopCommand}" CommandParameter="{Binding Catalog.Selected}"
                                    Visibility="{Binding Catalog.Selected.IsPlaying, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Margin="0,0,10,0" />
                                    <TextBlock Text="Остановить игру" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        </c:EditableElement>
                        <TextBlock Text="{Binding Catalog.Selected.StatusText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Профилей нет -->
                    <StackPanel Visibility="{Binding Catalog.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Пока нет ни одного профиля" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                        <TextBlock Text="Профиль — это версия игры со своими настройками и папкой для миров и модов."
                                   Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,16" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Создать профиль"
                                Command="{Binding CreateProfileCommand}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Нижняя строка -->
                    <Grid Margin="0,18,0,0" Visibility="{Binding Catalog.HasItems, Converter={StaticResource BoolToVis}}">
                        <c:EditableElement Id="account" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Account.ModeText, StringFormat=' · {0}'}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </c:EditableElement>
                        <c:EditableElement Id="create" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Создать профиль" Padding="14,7" FontSize="12"
                                    c:Ui.CornerRadius="11" Command="{Binding CreateProfileCommand}" />
                        </c:EditableElement>
                    </Grid>
                </StackPanel>
            </Border>
            </c:EditableElement>
        </StackPanel>

        <!-- Редактор интерфейса: панель свойств выбранного элемента -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Glass}" Padding="18" Width="320" Margin="0,0,24,24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="10"
                Visibility="{Binding Editor.IsEditing, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Редактор интерфейса" Style="{StaticResource SubHeading}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="Перетаскивайте элементы мышью, вкладки сверху тоже. Здесь можно выбрать элемент и точно поменять каждое свойство. Что делает кнопка — не меняется." />
                <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding Editor.Elements}"
                         SelectedItem="{Binding Editor.Selected, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Margin="0,12,0,0" Visibility="{Binding Editor.HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="Сдвиг по горизонтали" FontSize="12.5" />
                        <TextBox Text="{Binding Editor.X, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="64" Padding="6,2" FontSize="12" />
                    </Grid>
                    <Slider Minimum="-600" Maximum="600" SmallChange="1" LargeChange="10" Value="{Binding Editor.X, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock Text="Сдвиг по вертикали" FontSize="12.5" />
                        <TextBox Text="{Binding Editor.Y, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="64" Padding="6,2" FontSize="12" />
                    </Grid>
                    <Slider Minimum="-600" Maximum="600" SmallChange="1" LargeChange="10" Value="{Binding Editor.Y, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock Text="Слой (Z): больше — поверх" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Editor.Z, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="64" Padding="6,2" FontSize="12" />
                    </Grid>
                    <Slider Minimum="-20" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Editor.Z, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock Text="Размер" FontSize="12.5" />
                        <TextBox Text="{Binding Editor.Scale, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="64" Padding="6,2" FontSize="12" />
                    </Grid>
                    <Slider Minimum="0.3" Maximum="3" Value="{Binding Editor.Scale, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock Text="Прозрачность" FontSize="12.5" />
                        <TextBox Text="{Binding Editor.Opacity, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="64" Padding="6,2" FontSize="12" />
                    </Grid>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Editor.Opacity, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock Text="Скругление углов" FontSize="12.5" />
                        <TextBox Text="{Binding Editor.Corner, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="64" Padding="6,2" FontSize="12" />
                    </Grid>
                    <Slider Minimum="0" Maximum="60" Value="{Binding Editor.Corner, Mode=TwoWay}" />
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Показывать" FontSize="12.5" VerticalAlignment="Center" />
                        <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding Editor.ElementVisible, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Сетка 10 px (привязка)" FontSize="12.5" VerticalAlignment="Center" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Editor.SnapToGrid, Mode=TwoWay}" />
                </Grid>
                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Стрелки двигают выбранный элемент на 1 px (с Shift — на 10), Ctrl+Z / Ctrl+Y — отмена и повтор, Esc — выйти. Числа можно вписать точно." />

                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Отменить" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                            Margin="0,0,8,8" Command="{Binding Editor.UndoCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Повторить" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                            Margin="0,0,8,8" Command="{Binding Editor.RedoCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Готово" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                            Margin="0,0,8,8" Command="{Binding Editor.DoneCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Сбросить элемент" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                            Margin="0,0,8,8" Command="{Binding Editor.ResetElementCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Сбросить всё" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                            Margin="0,0,0,8" Command="{Binding Editor.ResetAllCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
