<UserControl x:Class="Launcher.UI.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Launcher.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,8,40,28" MaxWidth="1400">
            <Grid Margin="0,0,0,18">
                <TextBlock Text="Разработчик" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                <Button Style="{StaticResource DangerButton}" Content="Выйти из режима разработчика" HorizontalAlignment="Right"
                        Command="{Binding ExitCommand}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Проверка -->
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                        <StackPanel>
                            <TextBlock Text="Проверка" Style="{StaticResource SubHeading}" />
                            <Grid Margin="0,12,0,0">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="Счётчик кадров" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                               Text="Показывает FPS окна и время отрисовки 3D-модели в правом нижнем углу. Когда на экране ничего не движется, WPF не перерисовывает окно, и число будет низким — это нормально." />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              IsChecked="{Binding ShowFps, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="Максимальная графика" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                               Text="3D-модель всегда рисуется в полном размере окна без потери качества, даже когда вращается. Сильнее грузит процессор: включайте для проверки или на мощном компьютере." />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              IsChecked="{Binding MaxGraphics, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Text="Уведомления" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Content="Информация" Margin="0,0,8,8" Command="{Binding ToastCommand}" CommandParameter="info" />
                                <Button Style="{StaticResource GhostButton}" Content="Успех" Margin="0,0,8,8" Command="{Binding ToastCommand}" CommandParameter="success" />
                                <Button Style="{StaticResource GhostButton}" Content="Предупреждение" Margin="0,0,8,8" Command="{Binding ToastCommand}" CommandParameter="warning" />
                                <Button Style="{StaticResource GhostButton}" Content="Ошибка" Margin="0,0,8,8" Command="{Binding ToastCommand}" CommandParameter="error" />
                            </WrapPanel>

                            <TextBlock Text="Действия" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Content="Перечитать профили" Margin="0,0,8,8" Command="{Binding ReloadProfilesCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Перечитать значки" Margin="0,0,8,8" Command="{Binding ReloadIconsCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Сборка мусора" Margin="0,0,8,8" Command="{Binding CollectGarbageCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Папка лаунчера" Margin="0,0,8,8" Command="{Binding OpenLauncherFolderCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Журналы" Margin="0,0,8,8" Command="{Binding OpenLogsFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Диагностика -->
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Диагностика" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Авто" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ToggleButton Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  IsChecked="{Binding AutoRefresh, Mode=TwoWay}" />
                                    <Button Style="{StaticResource GhostButton}" Content="Обновить" Margin="0,0,8,0" Padding="14,7" FontSize="12"
                                            c:Ui.CornerRadius="11" Command="{Binding RefreshInfoCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="Копировать" Padding="14,7" FontSize="12"
                                            c:Ui.CornerRadius="11" Command="{Binding CopyInfoCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding Info, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Значки -->
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                        <StackPanel>
                            <TextBlock Text="Разрешение значков профилей" Style="{StaticResource SubHeading}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,10"
                                       Text="Картинки из папки icons загружаются в этом размере. Меньше — крупные пиксели, больше — чётче, но тяжелее." />
                            <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding SizeChoices}"
                                     SelectedItem="{Binding SelectedSize, Mode=TwoWay}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Редактор интерфейса -->
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Редактор интерфейса" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Content="Сбросить" HorizontalAlignment="Right"
                                        Padding="14,7" FontSize="12" c:Ui.CornerRadius="11" Command="{Binding ResetLayoutCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,10"
                                       Text="Редактор главной: кнопка ниже открывает главную в режиме правки — элементы (модель, название, панель, кнопки) и вкладки сверху перетаскиваются мышью, а справа можно точно задать положение, размер, прозрачность, скругление и видимость. Порядок вкладок можно менять и здесь: стрелки двигают вкладку, переключатель показывает или скрывает её. «Главную», «Настройки» и «Разработчика» скрыть нельзя." />

                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE70E;" Margin="0,0,6,0"
                                                    ToolTip="Раньше" Command="{Binding MoveUpCommand}" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70D;" Margin="0,0,14,0"
                                                    ToolTip="Позже" Command="{Binding MoveDownCommand}" />
                                            <ToggleButton Grid.Column="3" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}" IsEnabled="{Binding CanHide}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource PrimaryButton}" Content="Открыть редактор главной" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Command="{Binding Editor.StartCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
