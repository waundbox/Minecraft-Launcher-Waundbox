<UserControl x:Class="Launcher.UI.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Launcher.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,8,40,28" MaxWidth="1400" HorizontalAlignment="Stretch">
            <TextBlock Text="Аккаунт" Style="{StaticResource Heading}" />
            <TextBlock Text="Вход через Microsoft (пароль лаунчеру не передаётся: вы входите на сайте Microsoft) или через Ely.by."
                       Style="{StaticResource Muted}" Margin="0,4,0,18" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Аккаунт" Margin="0,0,8,0" Command="{Binding ShowAccountTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAccountTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Скины" Command="{Binding ShowSkinsTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSkinsTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Grid Visibility="{Binding ShowAccountTab, Converter={StaticResource BoolToVis}}">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0">
            <!-- Вход выполнен -->
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                        <Image Source="{Binding MicrosoftHead}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Microsoft · скин с серверов Mojang" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Выйти" VerticalAlignment="Center"
                            Command="{Binding LogoutCommand}" />
                </Grid>
            </Border>

            <!-- Вход не выполнен -->
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True"
                    Visibility="{Binding ShowSignedOut, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Вход в Microsoft" Style="{StaticResource SubHeading}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14"
                               Text="Нужна лицензионная копия Minecraft: Java Edition. Нажмите «Войти» — откроется страница Microsoft, на ней нужно ввести короткий код." />

                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14"
                            Visibility="{Binding ClientIdMissing, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                   Text="Вход в Microsoft сейчас недоступен в этой сборке. Можно играть в локальном режиме (см. ниже) или войти через Ely.by." />
                    </Border>

                    <StackPanel Visibility="{Binding HasCode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                        <TextBlock Text="Ваш код" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding UserCode}" FontSize="38" FontWeight="SemiBold" FontFamily="Consolas"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Открыть страницу входа" Margin="0,0,8,0"
                                    Command="{Binding OpenVerificationCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Копировать код"
                                    Command="{Binding CopyCodeCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Войти через Microsoft" Margin="0,0,10,0"
                                Command="{Binding LoginCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Отмена" Command="{Binding CancelLoginCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Локальный режим -->
            <Border Style="{StaticResource Glass}" c:Motion.Appear="True">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Локальный режим" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                        <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True"
                                HorizontalAlignment="Right" ToolTip="Скин, который используется в этом режиме">
                            <Image Source="{Binding DevHead}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14"
                               Text="Если вы не вошли в Microsoft, игра запускается с этим ником и без проверки лицензии. Это не официальная авторизация: на серверы с проверкой лицензии зайти не получится. Подходит для проверки запуска и одиночной игры." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DevUsername, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Сохранить" Margin="10,0,0,0"
                                Command="{Binding SaveDevNameCommand}" />
                    </Grid>
                    <TextBlock Text="3–16 символов: латинские буквы, цифры и подчёркивание." Style="{StaticResource Muted}"
                               FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
</StackPanel>
<StackPanel Grid.Column="2">
            <!-- Ely.by -->
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Ely.by" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Content="Открыть ely.by" HorizontalAlignment="Right"
                                Padding="14,7" FontSize="12" c:Ui.CornerRadius="11" Command="{Binding OpenElyCommand}" />
                    </Grid>

                    <!-- вошли -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding ElySignedIn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True"
                                VerticalAlignment="Top" Margin="0,0,16,0">
                            <Image Source="{Binding ElyHead}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElyUsername}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Ely.by · скин с сайта ely.by" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Скин меняется на сайте ely.by и подхватывается при следующем запуске игры." />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Выйти" VerticalAlignment="Top"
                                Command="{Binding ElyLogoutCommand}" />
                    </Grid>

                    <!-- не вошли -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ElySignedOut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Вход идёт на сервер авторизации Ely.by и даёт скины с этого сайта (в том числе на серверах Ely.by). Пароль отправляется только на authserver.ely.by и нигде не сохраняется: на диске остаётся лишь токен, зашифрованный средствами Windows. Это не аккаунт Microsoft." />
                        <TextBlock Text="Ник или e-mail" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ElyLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                        <TextBlock Text="Пароль" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ElyPassword" Margin="0,0,0,10" />
                        <StackPanel Visibility="{Binding ElyNeedsCode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Код двухфакторной защиты" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ElyCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Margin="0,0,0,10" />
                        </StackPanel>
                        <TextBlock Text="{Binding ElyStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Войти через Ely.by" HorizontalAlignment="Left"
                                Command="{Binding ElyLoginCommand}" CommandParameter="{Binding ElementName=ElyPassword}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Какой аккаунт использовать -->
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <StackPanel>
                    <TextBlock Text="Какой аккаунт использовать для запуска" Style="{StaticResource SubHeading}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,10"
                               Text="«Автоматически»: Microsoft, если вы вошли, иначе Ely.by, иначе локальный режим. Если выбранный аккаунт не подключён, лаунчер возьмёт первый доступный." />
                    <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding PreferredChoices}"
                             SelectedItem="{Binding SelectedPreferred, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
</StackPanel>
</Grid>

            <StackPanel Visibility="{Binding ShowSkinsTab, Converter={StaticResource BoolToVis}}">
            <!-- Скин -->
            <Border Style="{StaticResource Glass}" Margin="0,0,0,16" c:Motion.Appear="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,20,0">
                        <Border Width="96" Height="96" CornerRadius="16" Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding SkinHead}" Stretch="Uniform" Margin="8"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Visibility="{Binding HasSkin, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="34"
                                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                           Visibility="{Binding NoSkin, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Скин для одиночной игры" Style="{StaticResource SubHeading}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,12"
                                   Text="Выберите PNG-файл скина 64×64 — в одиночной игре (локальный режим, Minecraft 1.13 и новее) вы будете играть с ним. На серверах другие игроки этот скин не увидят. С аккаунтом Microsoft используется скин этого аккаунта, с Ely.by — скин с сайта ely.by." />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Выбрать скин…" Margin="0,0,10,0"
                                    Command="{Binding ChooseSkinCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Убрать скин"
                                    Command="{Binding RemoveSkinCommand}" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Тонкие руки (модель Alex)" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding SkinSlim, Mode=TwoWay}" />
                        </Grid>

                        <!-- Смена скина у аккаунта Microsoft (серверы Mojang) -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Скин аккаунта Microsoft" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10"
                                       Text="Загружает PNG 64×64 на серверы Mojang: новый скин увидят все игроки и в официальном лаунчере. Модель (Steve или Alex) берётся из переключателя выше. Mojang ограничивает частоту смены скина." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Сменить скин в Microsoft…" HorizontalAlignment="Left"
                                    Command="{Binding UploadMicrosoftSkinCommand}" />
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Коллекция скинов -->
            <Border Style="{StaticResource Glass}" c:Motion.Appear="True">
                <StackPanel DataContext="{Binding Skins}">
                    <Grid>
                        <TextBlock Text="Мои скины" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Добавить скин…" HorizontalAlignment="Right"
                                Padding="14,7" FontSize="12" c:Ui.CornerRadius="11" Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,12"
                               Text="Коллекция хранится на этом компьютере. «Выбрать» делает скин текущим (главная и одиночная игра); «В Microsoft» дополнительно загружает его в ваш аккаунт." />
                    <TextBlock Text="Пока пусто: добавьте PNG-файл скина 64×64." Style="{StaticResource Muted}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Margin="0,0,12,12" Padding="10" CornerRadius="14" Background="{DynamicResource PanelBrush}"
                                        BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Image Source="{Binding Preview}" Height="160" SnapsToDevicePixels="True" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding ModelText}" Style="{StaticResource Muted}" FontSize="11.5" TextAlignment="Center" />
                                        <Button Style="{StaticResource GhostButton}" Content="Выбрать" Margin="0,8,0,0" Padding="8,5" FontSize="12"
                                                Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Content="В Microsoft" Margin="0,6,0,0" Padding="8,5" FontSize="12"
                                                Command="{Binding DataContext.ApplyToMicrosoftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Content="Удалить" Margin="0,6,0,0" Padding="8,5" FontSize="12"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
