<Application x:Class="Launcher.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.UI.ViewModels"
             xmlns:views="clr-namespace:Launcher.UI.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Какая страница показывается для какой модели -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <views:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConsoleViewModel}">
                <views:ConsoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                <views:AccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeveloperViewModel}">
                <views:DeveloperView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdateViewModel}">
                <views:UpdateView />
            </DataTemplate>

            <!-- Диалоги -->
            <DataTemplate DataType="{x:Type vm:NewProfileViewModel}">
                <views:NewProfileDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileEditViewModel}">
                <views:ProfileEditDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <views:ModsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportPackViewModel}">
                <views:ImportPackDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomJarViewModel}">
                <views:CustomJarDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfirmViewModel}">
                <views:ConfirmDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdateDialogViewModel}">
                <views:UpdateDialog />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
