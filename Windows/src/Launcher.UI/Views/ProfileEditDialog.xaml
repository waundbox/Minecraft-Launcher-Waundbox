<UserControl x:Class="Launcher.UI.Views.ProfileEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Launcher.UI.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
            <Grid>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" Margin="0,0,48,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Закрыть" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Command="{Binding CancelCommand}" />
            </Grid>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,2,0,16" />

            <TextBlock Text="Название профиля" Style="{StaticResource Muted}" Margin="0,0,0,6" />
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,0,4" />
            <TextBlock Text="Латинские буквы, цифры, пробел, точка, дефис и подчёркивание (название — это и имя папки игры)."
                       Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

            <v:IconPicker DataContext="{Binding Icons}" Margin="0,0,0,16" />

            <v:MemoryPicker DataContext="{Binding Memory}" />

            <TextBlock Text="Сборщик мусора (GC)" Style="{StaticResource Muted}" Margin="0,16,0,8" />
            <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding GcChoices}"
                     SelectedItem="{Binding SelectedGc, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding GcHint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,16" />

            <TextBlock Text="Аргументы Java (необязательно)" Style="{StaticResource Muted}" Margin="0,0,0,6" />
            <TextBox Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Аргументы игры (необязательно)" Style="{StaticResource Muted}" Margin="0,12,0,6" />
            <TextBox Text="{Binding GameArguments, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Путь к Java только для этого профиля (необязательно)" Style="{StaticResource Muted}" Margin="0,12,0,6" />
            <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <Grid Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource DangerButton}" Content="Удалить" Margin="0,0,8,0" Command="{Binding DeleteCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Папка" Command="{Binding OpenFolderCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Отмена" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
