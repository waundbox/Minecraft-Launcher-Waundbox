<UserControl x:Class="Launcher.UI.Views.ModsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Launcher.UI.Controls">
    <UserControl.Resources>
        <!-- Карточка проекта (каталог и рекомендуемое) -->
        <DataTemplate x:Key="ProjectCard">
            <Border Style="{StaticResource Glass}" Padding="14" Margin="0,0,10,10" CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <Image Source="{Binding IconUrl, IsAsync=True}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                   MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,3,0,4" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" FontSize="11.5" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="14,8"
                            c:Ui.CornerRadius="12" MinWidth="110" Content="{Binding ButtonText}" Command="{Binding InstallCommand}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Margin="0,0,12,12">
            <StackPanel>
                <TextBlock Text="Моды и ресурсы" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Content="Папка" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                        Margin="0,0,8,0" Command="{Binding OpenFolderCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="Закрыть" Padding="14,7" FontSize="12" c:Ui.CornerRadius="11"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>

        <!-- Тип и раздел -->
        <Grid Grid.Row="1" Margin="0,0,12,10">
            <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding TypeChoices}"
                     SelectedItem="{Binding SelectedType, Mode=TwoWay}" HorizontalAlignment="Left">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding SectionChoices}"
                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}" HorizontalAlignment="Right">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Поиск (только в каталоге) -->
        <StackPanel Grid.Row="2" Margin="0,0,12,10" Visibility="{Binding ShowCatalog, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название или слово из описания. Enter — найти.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Найти" Margin="10,0,0,0" Padding="18,9"
                        c:Ui.CornerRadius="12" Command="{Binding SearchCommand}" />
            </Grid>
            <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding SortChoices}"
                     SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Margin="0,8,0,0" HorizontalAlignment="Left">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding ShopHint}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0" />
        </StackPanel>

        <!-- Содержимое -->
        <Grid Grid.Row="3">
            <!-- Каталог -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowCatalog, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ProjectCard}" />
                    <Button Style="{StaticResource GhostButton}" Content="Показать ещё" HorizontalAlignment="Center" Padding="20,9"
                            Margin="0,0,0,10" Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Рекомендуем -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowRecommended, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource ProjectCard}" Margin="0,0,12,0" />
            </ScrollViewer>

            <!-- Установлено -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowInstalled, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,12,0">
                    <Grid Margin="0,0,0,10" Visibility="{Binding HasInstalled, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Проверить обновления" Padding="14,8" FontSize="12.5"
                                    c:Ui.CornerRadius="11" Margin="0,0,8,0" Command="{Binding CheckUpdatesCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Обновить всё" Padding="14,8" FontSize="12.5"
                                    c:Ui.CornerRadius="11" Command="{Binding UpdateAllCommand}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Installed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Glass}" Padding="14,12" Margin="0,0,0,8" CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding UpdateText}" Margin="10,0,0,0"
                                                Padding="12,7" FontSize="12" c:Ui.CornerRadius="10" Command="{Binding UpdateCommand}"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                        <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="Удалить" Margin="8,0,0,0"
                                                Padding="12,7" FontSize="12" c:Ui.CornerRadius="10" Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Сообщение вместо пустого списка -->
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="0,0,12,0"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Состояние -->
        <StackPanel Grid.Row="4" Margin="0,8,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
