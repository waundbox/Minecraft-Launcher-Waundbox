<UserControl x:Class="Launcher.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Launcher.UI.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" MinWidth="380" />
            <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Справа: 3D-модель игрока со скином (перетаскивайте мышью, чтобы повернуть) -->
        <c:EditableElement Id="model" Grid.Column="1" Margin="0,16,16,16" MaxWidth="640">
            <Grid>
                <!-- мягкая тень на «полу» под ногами персонажа -->
                <Grid IsHitTestVisible="False" Visibility="{Binding Account.ShowModel3D, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions><RowDefinition Height="0.8*" /><RowDefinition Height="0.2*" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.18*" /><ColumnDefinition Width="0.64*" /><ColumnDefinition Width="0.18*" /></Grid.ColumnDefinitions>
                    <Ellipse Grid.Row="1" Grid.Column="1" Height="30" VerticalAlignment="Center" Opacity="0.9">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#99000000" Offset="0" />
                                <GradientStop Color="#55000000" Offset="0.45" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <c:SkinViewer Visibility="{Binding Account.ShowModel3D, Converter={StaticResource BoolToVis}}"
                          SkinPng="{Binding Account.ModelSkinPng}" Slim="{Binding Account.ModelSlim}" Model="{Binding Account.CustomModel}"
                          PoseId="{Binding Account.ModelPoseId}" ShowOverlay="{Binding Account.ModelOverlay}" AutoSpin="{Binding Account.ModelSpin}"
                          c:Motion.Appear="True" />
            </Grid>
        </c:EditableElement>

        <!-- Панель запуска: при выключенной 3D-модели занимает обе колонки и стоит по центру -->
        <StackPanel VerticalAlignment="Center" MaxWidth="720" Margin="24,0,24,24">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="PanelScale" />
            </StackPanel.LayoutTransform>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Account.ShowModel3D}" Value="False">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Название лаунчера: ровный цвет, без блика -->
            <c:EditableElement Id="wordmark">
            <Image x:Name="Wordmark" Source="{DynamicResource WordmarkImage}" HorizontalAlignment="Center"
                   Width="420" Margin="0,-20,0,0" RenderOptions.BitmapScalingMode="HighQuality" c:Motion.Appear="True" />
            </c:EditableElement>
            <c:EditableElement Id="tagline">
                <TextBlock Text="Лаунчер Minecraft" Style="{StaticResource Muted}" Foreground="{DynamicResource TaglineBrush}" HorizontalAlignment="Center"
                           Margin="0,2,0,46" FontSize="14" c:Motion.Appear="True" />
            </c:EditableElement>

            <c:EditableElement Id="panel">
            <Border Style="{StaticResource Glass}" Padding="30" c:Motion.Appear="True">
                <StackPanel>

                    <!-- Есть профили -->
                    <StackPanel Visibility="{Binding Catalog.HasItems, Converter={StaticResource BoolToVis}}">
                        <c:EditableElement Id="profiles">
                        <StackPanel>
                        <TextBlock Text="Профиль" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <ListBox x:Name="ProfileList" Style="{StaticResource ChipListBox}" MaxHeight="124" c:ProfileReorder.Enabled="True"
                                 ItemsSource="{Binding Catalog.Items}"
                                 SelectedItem="{Binding Catalog.Selected, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>
                        </c:EditableElement>

                        <c:EditableElement Id="play">
                        <Grid Margin="0,18,0,0" MinHeight="74">
                            <Button FontSize="22" c:Ui.CornerRadius="20"
                                    Command="{Binding Launcher.PlayCommand}" CommandParameter="{Binding Catalog.Selected}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Catalog.Selected.IsIdle}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,10,0" />
                                    <TextBlock Text="Играть" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button FontSize="20" c:Ui.CornerRadius="20"
                                    Command="{Binding Launcher.StopCommand}" CommandParameter="{Binding Catalog.Selected}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Catalog.Selected.IsPlaying}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Margin="0,0,10,0" />
                                    <TextBlock Text="Остановить игру" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        </c:EditableElement>
                        <TextBlock Text="{Binding Catalog.Selected.StatusText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Профилей нет -->
                    <StackPanel Visibility="{Binding Catalog.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Пока нет ни одного профиля" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                        <TextBlock Text="Профиль — это версия игры со своими настройками и папкой для миров и модов."
                                   Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,16" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Создать профиль"
                                Command="{Binding CreateProfileCommand}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Нижняя строка -->
                    <Grid Margin="0,18,0,0" Visibility="{Binding Catalog.HasItems, Converter={StaticResource BoolToVis}}">
                        <c:EditableElement Id="account" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Account.ModeText, StringFormat=' · {0}'}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </c:EditableElement>
                        <c:EditableElement Id="create" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Создать профиль" Padding="14,7" FontSize="12"
                                    c:Ui.CornerRadius="11" Command="{Binding CreateProfileCommand}" />
                        </c:EditableElement>
                    </Grid>
                </StackPanel>
            </Border>
            </c:EditableElement>
        </StackPanel>
    </Grid>
</UserControl>
