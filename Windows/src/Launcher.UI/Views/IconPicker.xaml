<UserControl x:Class="Launcher.UI.Views.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Значок профиля" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Style="{StaticResource GhostButton}" Content="Папка значков" HorizontalAlignment="Right"
                    Padding="12,5" FontSize="12" Command="{Binding OpenFolderCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Text="Пока в папке значков нет картинок. Положите туда файлы .png или .jpg (лучше квадратные) и откройте этот диалог заново."
                   Visibility="{Binding HasNoIcons, Converter={StaticResource BoolToVis}}" />
        <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding Choices}" MaxHeight="150"
                 SelectedItem="{Binding Selected, Mode=TwoWay}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding HasIcons, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="32" Height="32">
                        <Image Source="{Binding Image}" Stretch="Uniform"
                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" ToolTip="Без значка"
                                   Visibility="{Binding IsNone, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
